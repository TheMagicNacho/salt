<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
        Name="Salt Text Editor"
        Manufacturer="TheMagicNacho"
        Version="0.1.0"
        UpgradeCode="A7D57C58-6923-4554-9E02-86A76EE7F320"
        Scope="perMachine"
    >

    <MajorUpgrade
            DowngradeErrorMessage="A newer version of [ProductName] is already installed."
        />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Salt" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />

    <ComponentGroup Id="ProductComponents">
      <!-- Main executable in C:\Program Files\Salt -->
      <Component Id="SaltExeComponent" Directory="INSTALLFOLDER">
        <File Id="SaltExecutable" Source="$(var.SourceExe)" KeyPath="yes" />
      </Component>

      <!-- Machine PATH environment variable -->
      <Component Id="PathEnvironmentComponent" Directory="INSTALLFOLDER">
        <Environment
                    Id="PATH"
                    Name="PATH"
                    Value="[INSTALLFOLDER]"
                    Permanent="no"
                    Part="last"
                    Action="set"
                    System="yes"
                />
        <RegistryValue
                    Root="HKLM"
                    Key="Software\Salt"
                    Name="PathConfigured"
                    Type="integer"
                    Value="1"
                    KeyPath="yes"
                />
      </Component>

      <!-- Start Menu Shortcut for Windows Search indexing -->
      <Component Id="StartMenuShortcutComponent" Directory="ProgramMenuFolder">
        <Shortcut
                    Id="ApplicationStartMenuShortcut"
                    Name="Salt"
                    Description="Salt Text Editor"
                    Target="[INSTALLFOLDER]salt.exe"
                    WorkingDirectory="INSTALLFOLDER"
                />
        <RegistryValue
                    Root="HKCU"
                    Key="Software\Salt"
                    Name="Installed"
                    Type="integer"
                    Value="1"
                    KeyPath="yes"
                />
      </Component>

      <!-- "Open with Salt" context menu for all files (*) -->
      <Component Id="OpenWithContextMenuComponent" Directory="INSTALLFOLDER">
        <RegistryKey Root="HKCR" Key="*\shell\Open with Salt">
          <RegistryValue Type="string" Value="Open with Salt" />
          <RegistryValue
                        Name="Icon"
                        Type="string"
                        Value="&quot;[INSTALLFOLDER]salt.exe&quot;,0"
                    />
          <RegistryKey Key="command">
            <RegistryValue
                            Type="string"
                            Value="&quot;[INSTALLFOLDER]salt.exe&quot; &quot;%1&quot;"
                            KeyPath="yes"
                        />
          </RegistryKey>
        </RegistryKey>
      </Component>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="Salt" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>
  </Package>
</Wix>
